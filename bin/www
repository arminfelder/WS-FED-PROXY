#!/usr/bin/env node

const fs = require('fs');
const http = require('http');
const https = require('https');
const path = require('path');
const debug = require('debug')('ws-fed-saml-proxy:server');
const { parseIntEnv } = require('../util/parseIntEnv');

function fatal(message) {
    console.error(`FATAL: ${message}`);
    process.exit(1);
}

// A non-numeric PORT would make http.Server listen on a named pipe of that name.
let port;
try {
    port = parseIntEnv('PORT', process.env.PORT, { def: 3000, min: 1, max: 65535 });
} catch (err) {
    fatal(err.message);
}

const app = require('../app');
app.set('port', port);

// TLS on the Node process itself is for local use. The deployment terminates TLS in front.
function tlsOptions() {
    const read = (name, fallback) => fs.readFileSync(path.join(__dirname, process.env[name] || fallback));
    try {
        return {
            key: read('HTTPS_KEY', '../selfsigned.key'),
            cert: read('HTTPS_CERT', '../selfsigned.crt'),
        };
    } catch (err) {
        return fatal(`cannot read the HTTPS key or certificate: ${err.message}`);
    }
}

const useTls = (process.env.HTTPS || '').toLowerCase() === 'true';
const server = useTls ? https.createServer(tlsOptions(), app) : http.createServer(app);

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

// Node is PID 1 in the container, so nothing else turns SIGTERM into a clean stop.
// Idle keep-alive connections are closed at once; in-flight responses get ten seconds.
function shutdown(signal) {
    debug(`${signal}: closing the server`);
    server.close(() => process.exit(0));
    server.closeIdleConnections();
    setTimeout(() => process.exit(1), 10000).unref();
}
process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));

function onError(error) {
    if (error.syscall !== 'listen') {
        throw error;
    }
    switch (error.code) {
        case 'EACCES':
            return fatal(`port ${port} requires elevated privileges`);
        case 'EADDRINUSE':
            return fatal(`port ${port} is already in use`);
        default:
            throw error;
    }
}

function onListening() {
    debug(`Listening on port ${server.address().port}`);
}
