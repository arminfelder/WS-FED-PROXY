# Local-stack files. A developer .env can hold SESSION_SECRET or KC_ADMIN_PW;
# the Dockerfile copies the whole context into the runtime image.
.env
.env.*
docker-compose.yaml
nginx.conf
deploy
Dockerfile
*.md

# Documentation sources, build output and CI files: nothing in them runs in the container.
docs
dist
.gitlab-ci.yml
.github
sonar-project.properties
eslint.config.js
*.tex
*.pdf
*.aux
*.fls
*.log
*.out
*.toc
*.fdb_latexmk

# Keys, certs and captures that live in the working tree during development.
# certs/ is mounted at runtime; nothing here belongs in a layer.
*.key
*.pem
*.crt
*.p7b
*.har
*.gpg
bak
audit.json
yarn.lock

# …except the throwaway fixtures the builder's `npm test` stage signs with.
!test/fixtures/test-cert.key
!test/fixtures/test-cert.pem
